<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security: Block direct access to hidden files and sensitive configuration
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan) - [F,L,NC]

    # Rewrite all traffic to public directory if not already pointing there
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<FilesMatch "^\.(env|git)">
    Order allow,deny
    Deny from all
</FilesMatch>
